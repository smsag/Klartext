#!/bin/sh
# Lint, guard and rebuild before a commit that touches the stylesheet, the
# fonts, the build, the guards or this hook. Enable once per clone:
#     git config core.hooksPath .githooks
# The same checks as CI (.github/workflows/ci.yml), so a commit that passes
# here passes there: stylelint at CI's pinned version (skipped quietly when
# npx is not installed), tools/guards.mjs (plain node, no dependencies), and
# a theme.css that is what fonts/embed.py builds from src/theme.css.
#
# The checks run on the commit, not on the working tree: the staged files are
# exported to a scratch folder first, so an unstaged fix in the working tree
# cannot pass a broken stylesheet into the commit.
if ! git diff --cached --name-only | grep -Eq '^(src/|theme\.css$|fonts/|tools/|\.githooks/|\.stylelintrc\.json$)'; then
  exit 0
fi

staged="$(mktemp -d)" || exit 1
trap 'rm -rf "$staged"' EXIT
git checkout-index --all --prefix="$staged/" || { echo "could not export the staged files; commit aborted"; exit 1; }

if command -v npx >/dev/null 2>&1; then
  (cd "$staged" && npx --yes stylelint@17.16.0 src/theme.css) || { echo "stylelint failed; commit aborted"; exit 1; }
fi

node "$staged/tools/guards.mjs" || { echo "guards failed; commit aborted"; exit 1; }

cp "$staged/theme.css" "$staged/.theme.staged.css"
python3 "$staged/fonts/embed.py" >/dev/null || { echo "fonts/embed.py failed; commit aborted"; exit 1; }
if ! cmp -s "$staged/theme.css" "$staged/.theme.staged.css"; then
  echo "theme.css in this commit is not what fonts/embed.py builds from the staged src/theme.css."
  echo "Run python3 fonts/embed.py, git add theme.css, and commit again."
  exit 1
fi
