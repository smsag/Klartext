#!/bin/sh
# Lint and guard the stylesheet before a commit that touches it. Enable once
# per clone:
#     git config core.hooksPath .githooks
# Runs for a change to the stylesheet.
# stylelint is skipped quietly when npx is not installed; every tools/check-*
# guard is plain node with no dependencies, so they always run.
if git diff --cached --name-only | grep -q '^src/theme\.css$'; then
  if command -v npx >/dev/null 2>&1; then
    npx --yes stylelint src/theme.css || { echo "stylelint failed; commit aborted"; exit 1; }
  fi
  for guard in tools/check-*.mjs; do
    node "$guard" || { echo "$guard failed; commit aborted"; exit 1; }
  done
fi
