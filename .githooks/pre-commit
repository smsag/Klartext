#!/bin/sh
# Lint the stylesheet before a commit that touches it. Enable once per clone:
#     git config core.hooksPath .githooks
# Skips quietly when npx is not installed.
if git diff --cached --name-only | grep -q '^src/theme.css$'; then
  command -v npx >/dev/null 2>&1 || exit 0
  npx --yes stylelint src/theme.css || { echo "stylelint failed; commit aborted"; exit 1; }
fi
